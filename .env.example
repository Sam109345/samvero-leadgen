# ==============================================================================
# SAMEERLY LEAD GENERATION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# All keys have graceful fallbacks. If any key is missing or quota is exceeded,
# Sameerly seamlessly switches to free/public APIs or built-in high-fidelity live feeds.

# Platform Configuration
PORT=3000
NEXT_PUBLIC_APP_NAME="Sameerly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PLATFORM_TAGLINE="Next-Gen Lead Generation & Client Acquisition Engine"

# 1. Google Places / Maps API (Optional Free Tier: $200 monthly free credit from Google Cloud)
# Get from: https://console.cloud.google.com/apis/credentials (Enable Places API)
GOOGLE_PLACES_API_KEY=""

# 2. SerpApi (Optional Free Tier: 100 free searches/month)
# Useful for scraping Google Maps & Google Jobs with zero setup: https://serpapi.com/
SERPAPI_API_KEY=""

# 3. Adzuna Job Search API (Free Tier: 250 calls/day for jobs in US, UK)
# Get App ID & App Key from: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# 4. Email Outreach Service (Nodemailer / Free SMTP or Resend)
# Option A: Resend (Free 3,000 emails/month): https://resend.com
RESEND_API_KEY=""

# Option B: Standard SMTP (Gmail App Password, Brevo, or SendGrid free tier)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sameerly Leads <noreply@sameerly.io>"

# Rate Limiting & Safety Quota Limits (Requests per hour)
GOOGLE_RATE_LIMIT=60
SERPAPI_RATE_LIMIT=10
OUTREACH_EMAIL_HOURLY_LIMIT=20
